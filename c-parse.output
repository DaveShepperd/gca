State 43 conflicts: 1 shift/reduce
State 95 conflicts: 1 shift/reduce
State 102 conflicts: 1 shift/reduce
State 106 conflicts: 1 shift/reduce
State 122 conflicts: 1 shift/reduce
State 186 conflicts: 1 shift/reduce
State 197 conflicts: 1 shift/reduce
State 203 conflicts: 1 shift/reduce


Grammar

    0 $accept: program $end

    1 program: ε
    2        | extdefs

    3 @1: ε

    4 extdefs: @1 extdef

    5 @2: ε

    6 extdefs: extdefs @2 extdef

    7 extdef: fndef
    8       | datadef
    9       | ASM '(' string ')' ';'

   10 datadef: setspecs notype_initdecls ';'
   11        | declmods setspecs notype_initdecls ';'
   12        | typed_declspecs setspecs initdecls ';'
   13        | declmods ';'
   14        | typed_declspecs ';'
   15        | error ';'
   16        | error '}'
   17        | ';'

   18 $@3: ε

   19 $@4: ε

   20 fndef: typed_declspecs setspecs declarator $@3 xdecls $@4 compstmt_or_error
   21      | typed_declspecs setspecs declarator error

   22 $@5: ε

   23 $@6: ε

   24 fndef: declmods setspecs notype_declarator $@5 xdecls $@6 compstmt_or_error
   25      | declmods setspecs notype_declarator error

   26 $@7: ε

   27 $@8: ε

   28 fndef: setspecs notype_declarator $@7 xdecls $@8 compstmt_or_error
   29      | setspecs notype_declarator error

   30 identifier: IDENTIFIER
   31           | TYPENAME

   32 unop: '&'
   33     | '-'
   34     | '+'
   35     | PLUSPLUS
   36     | MINUSMINUS
   37     | '~'
   38     | '!'

   39 expr: nonnull_exprlist

   40 exprlist: ε
   41         | nonnull_exprlist

   42 nonnull_exprlist: expr_no_commas
   43                 | nonnull_exprlist ',' expr_no_commas

   44 unary_expr: primary
   45           | '*' cast_expr
   46           | unop cast_expr
   47           | SIZEOF unary_expr
   48           | SIZEOF '(' typename ')'
   49           | ALIGNOF unary_expr
   50           | ALIGNOF '(' typename ')'

   51 cast_expr: unary_expr
   52          | '(' typename ')' cast_expr
   53          | '(' typename ')' '{' initlist maybecomma '}'

   54 expr_no_commas: cast_expr
   55               | expr_no_commas '+' expr_no_commas
   56               | expr_no_commas '-' expr_no_commas
   57               | expr_no_commas '*' expr_no_commas
   58               | expr_no_commas '/' expr_no_commas
   59               | expr_no_commas '%' expr_no_commas
   60               | expr_no_commas LSHIFT expr_no_commas
   61               | expr_no_commas RSHIFT expr_no_commas
   62               | expr_no_commas ARITHCOMPARE expr_no_commas
   63               | expr_no_commas EQCOMPARE expr_no_commas
   64               | expr_no_commas '&' expr_no_commas
   65               | expr_no_commas '|' expr_no_commas
   66               | expr_no_commas '^' expr_no_commas
   67               | expr_no_commas ANDAND expr_no_commas
   68               | expr_no_commas OROR expr_no_commas
   69               | expr_no_commas '?' xexpr ':' expr_no_commas
   70               | expr_no_commas '=' expr_no_commas
   71               | expr_no_commas ASSIGN expr_no_commas

   72 primary: IDENTIFIER
   73        | CONSTANT
   74        | string
   75        | '(' expr ')'
   76        | '(' error ')'

   77 @9: ε

   78 primary: '(' @9 compstmt ')'
   79        | primary '(' exprlist ')'
   80        | primary '[' expr ']'
   81        | primary '.' identifier
   82        | primary POINTSAT identifier
   83        | primary PLUSPLUS
   84        | primary MINUSMINUS

   85 string: STRING
   86       | string STRING

   87 xdecls: ε
   88       | decls

   89 decls: decl
   90      | errstmt
   91      | decls decl
   92      | decl errstmt

   93 setspecs: ε

   94 decl: typed_declspecs setspecs initdecls ';'
   95     | declmods setspecs notype_initdecls ';'
   96     | typed_declspecs ';'
   97     | declmods ';'

   98 typed_declspecs: typespec reserved_declspecs
   99                | declmods typespec reserved_declspecs

  100 reserved_declspecs: ε
  101                   | reserved_declspecs typespecqual_reserved
  102                   | reserved_declspecs SCSPEC

  103 declmods: TYPE_QUAL
  104         | SCSPEC
  105         | declmods TYPE_QUAL
  106         | declmods SCSPEC

  107 typed_typespecs: typespec reserved_typespecquals
  108                | nonempty_type_quals typespec reserved_typespecquals

  109 reserved_typespecquals: ε
  110                       | reserved_typespecquals typespecqual_reserved

  111 typespec: TYPESPEC
  112         | structsp
  113         | TYPENAME
  114         | TYPEOF '(' expr ')'
  115         | TYPEOF '(' typename ')'

  116 typespecqual_reserved: TYPESPEC
  117                      | TYPE_QUAL
  118                      | structsp

  119 initdecls: initdcl
  120          | initdecls ',' initdcl

  121 notype_initdecls: notype_initdcl
  122                 | notype_initdecls ',' initdcl

  123 maybeasm: ε
  124         | ASM '(' string ')'

  125 @10: ε

  126 initdcl: declarator maybeasm maybe_attribute '=' @10 init
  127        | declarator maybeasm maybe_attribute

  128 @11: ε

  129 notype_initdcl: notype_declarator maybeasm maybe_attribute '=' @11 init
  130               | notype_declarator maybeasm maybe_attribute

  131 maybe_attribute: ε
  132                | ATTRIBUTE '(' '(' attribute_list ')' ')'

  133 attribute_list: attrib
  134               | attribute_list ',' attrib

  135 attrib: IDENTIFIER
  136       | IDENTIFIER '(' CONSTANT ')'
  137       | IDENTIFIER '(' identifiers ')'

  138 init: expr_no_commas
  139     | '{' '}'
  140     | '{' initlist '}'
  141     | '{' initlist ',' '}'
  142     | error

  143 initlist: init
  144         | initlist ',' init

  145 declarator: after_type_declarator
  146           | notype_declarator

  147 after_type_declarator: '(' after_type_declarator ')'
  148                      | after_type_declarator '(' parmlist_or_identifiers
  149                      | after_type_declarator '[' expr ']'
  150                      | after_type_declarator '[' ']'
  151                      | '*' type_quals after_type_declarator
  152                      | TYPENAME

  153 parm_declarator: parm_declarator '(' parmlist_or_identifiers
  154                | parm_declarator '[' expr ']'
  155                | parm_declarator '[' ']'
  156                | '*' type_quals parm_declarator
  157                | TYPENAME

  158 notype_declarator: notype_declarator '(' parmlist_or_identifiers
  159                  | '(' notype_declarator ')'
  160                  | '*' type_quals notype_declarator
  161                  | notype_declarator '[' expr ']'
  162                  | notype_declarator '[' ']'
  163                  | IDENTIFIER

  164 @12: ε

  165 structsp: STRUCT identifier '{' @12 component_decl_list '}'
  166         | STRUCT '{' component_decl_list '}'
  167         | STRUCT identifier

  168 @13: ε

  169 structsp: UNION identifier '{' @13 component_decl_list '}'
  170         | UNION '{' component_decl_list '}'
  171         | UNION identifier

  172 @14: ε

  173 structsp: ENUM identifier '{' @14 enumlist maybecomma_warn '}'

  174 @15: ε

  175 structsp: ENUM '{' @15 enumlist maybecomma_warn '}'
  176         | ENUM identifier

  177 maybecomma: ε
  178           | ','

  179 maybecomma_warn: ε
  180                | ','

  181 component_decl_list: component_decl_list2
  182                    | component_decl_list2 component_decl

  183 component_decl_list2: ε
  184                     | component_decl_list2 component_decl ';'
  185                     | component_decl_list2 ';'

  186 component_decl: typed_typespecs setspecs components
  187               | nonempty_type_quals setspecs components
  188               | error

  189 components: ε
  190           | component_declarator
  191           | components ',' component_declarator

  192 component_declarator: declarator maybe_attribute
  193                     | declarator ':' expr_no_commas maybe_attribute
  194                     | ':' expr_no_commas

  195 enumlist: enumerator
  196         | enumlist ',' enumerator

  197 enumerator: identifier
  198           | identifier '=' expr_no_commas

  199 typename: typed_typespecs absdcl
  200         | nonempty_type_quals absdcl

  201 absdcl: ε
  202       | absdcl1

  203 nonempty_type_quals: TYPE_QUAL
  204                    | nonempty_type_quals TYPE_QUAL

  205 type_quals: ε
  206           | type_quals TYPE_QUAL

  207 absdcl1: '(' absdcl1 ')'
  208        | '*' type_quals absdcl1
  209        | '*' type_quals
  210        | absdcl1 '(' parmlist
  211        | absdcl1 '[' expr ']'
  212        | absdcl1 '[' ']'
  213        | '(' parmlist
  214        | '[' expr ']'
  215        | '[' ']'

  216 stmts: stmt
  217      | stmts stmt
  218      | stmts errstmt

  219 xstmts: ε
  220       | stmts

  221 errstmt: error ';'

  222 pushlevel: ε

  223 compstmt_or_error: compstmt
  224                  | error compstmt

  225 compstmt: '{' '}'
  226         | '{' pushlevel decls xstmts '}'
  227         | '{' pushlevel error '}'
  228         | '{' pushlevel stmts '}'

  229 $@16: ε

  230 simple_if: IF '(' expr ')' $@16 stmt

  231 stmt: compstmt
  232     | expr ';'

  233 $@17: ε

  234 stmt: simple_if ELSE $@17 stmt
  235     | simple_if

  236 $@18: ε

  237 $@19: ε

  238 stmt: WHILE $@18 '(' expr ')' $@19 stmt

  239 $@20: ε

  240 $@21: ε

  241 stmt: DO $@20 stmt WHILE $@21 '(' expr ')' ';'

  242 $@22: ε

  243 $@23: ε

  244 $@24: ε

  245 stmt: FOR '(' xexpr ';' $@22 xexpr ';' $@23 xexpr ')' $@24 stmt

  246 $@25: ε

  247 stmt: SWITCH '(' expr ')' $@25 stmt

  248 $@26: ε

  249 stmt: CASE expr ':' $@26 stmt

  250 $@27: ε

  251 stmt: DEFAULT ':' $@27 stmt
  252     | BREAK ';'
  253     | CONTINUE ';'
  254     | RETURN ';'
  255     | RETURN expr ';'
  256     | ASM maybe_type_qual '(' string ')' ';'
  257     | ASM maybe_type_qual '(' string ':' asm_operands ')' ';'
  258     | ASM maybe_type_qual '(' string ':' asm_operands ':' asm_operands ')' ';'
  259     | ASM maybe_type_qual '(' string ':' asm_operands ':' asm_operands ':' asm_clobbers ')' ';'
  260     | GOTO identifier ';'

  261 $@28: ε

  262 stmt: identifier ':' $@28 stmt
  263     | ';'

  264 maybe_type_qual: ε
  265                | TYPE_QUAL

  266 xexpr: ε
  267      | expr

  268 asm_operands: ε
  269             | nonnull_asm_operands

  270 nonnull_asm_operands: asm_operand
  271                     | nonnull_asm_operands ',' asm_operand

  272 asm_operand: STRING '(' expr ')'

  273 asm_clobbers: string
  274             | asm_clobbers ',' string

  275 $@29: ε

  276 parmlist: $@29 parmlist_1

  277 $@30: ε

  278 parmlist_or_identifiers: $@30 parmlist_or_identifiers_1

  279 parmlist_or_identifiers_1: parmlist_2 ')'
  280                          | identifiers ')'
  281                          | error ')'

  282 parmlist_1: parmlist_2 ')'
  283           | error ')'

  284 parmlist_2: ε
  285           | parms
  286           | parms ',' ELLIPSIS

  287 parms: parm
  288      | parms ',' parm

  289 parm: typed_declspecs parm_declarator
  290     | typed_declspecs notype_declarator
  291     | typed_declspecs absdcl
  292     | declmods notype_declarator
  293     | declmods absdcl

  294 identifiers: IDENTIFIER
  295            | identifiers ',' IDENTIFIER


